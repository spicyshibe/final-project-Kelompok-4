PORT=3000

# URL frontend yang boleh akses API ini (buat CORS)
FRONTEND_URL=http://localhost:5173

# API Key untuk Gemini (Google Generative AI)
GEMINI_API_KEY=your_gemini_api_key_here

# WAJIB diisi - server gak bakal jalan tanpa ini. Generate random string panjang, contoh:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
